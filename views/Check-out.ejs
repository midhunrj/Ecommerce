                            <div class="mb-20">
                                <h4>Your Orders</h4>
                            </div>
                            <div class="table-responsive order_table text-center">
                                <% if(Cart ){ %>
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th colspan="2">Product</th>
                                                <th>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% let totalSubtotal = 0; %>
                                            <% for(let i=0; i<Cart.cartItems.length; i++) { %>
                                                <% let product = products.find(p => p._id.toString() === Cart.cartItems[i].product_id.toString()); %>
                                                <% if(product){ %>
                                                    <tr>
                                                        <td class="image product-thumbnail"><img src="./productImage/<%= product.image[0] %>" alt="#"></td>
                                                        <td>
                                                            <h5><a href="shop-product-full.html"><%= product.productname %></a></h5>
                                                            <span class="product-qty">x <%= Cart.cartItems[i].quantity %></span>
                                                        </td>
                                                        <% let subtotal = Cart.cartItems[i].price * Cart.cartItems[i].quantity %>
                                                        <td class="product-subtotal">₹<%= subtotal %></td>
                                                    </tr>
                                                    <% totalSubtotal += subtotal; %>
                                                <% } %>
                                            <% } %>
                                            
                                            <tr>
                                                <th>SubTotal</th>
                                                <td class="product-subtotal" colspan="2">₹<%= totalSubtotal %></td>
                                            </tr>
                                            
                                            <tr>
                                                <th>Shipping</th>
                                                <td colspan="2"><% let ship;if(totalSubtotal>=1000){ ship=0%><em>Free Shipping </em><% } else{ ship=40 %><em>₹<%= ship %></em><% } %></td>
                                                <% console.log("ship",ship);%>
                                            </tr>
                                            
                                            <tr>
                                                <th>Total</th>
                                                <td colspan="2" class="product-subtotal" ><span class="font-xl text-brand fw-900" id="total-ship">₹<%= totalSubtotal+ship %></span>
                                                    
                                                 </td>
                                                 </tr>
                                                 <tr><td colspan="3">
                                                    <div id="appliedCouponMessage"></div>
                                                    <div id="discountMessage" style="color: green; display: none;"></div>
                                                    <button id="removeCouponButton" class="btn btn-sm font-sm btn-info rounded" style="display: none;" onclick="removeCoupon()">Remove Coupon</button>
                                                </td>



                                            </tr>
                                        </tbody>
                                    </table>

                                
                            </div>
                        </div>
                    </div>
        
                    <div class="col-md-6">
                        <div class="mb-25">
                            <h4>Billing Details</h4>
                        </div>

                        <% if(userAddress && userAddress.Address.length > 0){ %>
                            <% userAddress.Address.forEach((Address) => { %>
                                <% console.log("Address array",Address._id); %>
                                <div class="col-lg-4">
                                    <div class="card mb-3 mb-lg-0">
                                        <div class="card-header">
                                            <div class="address-item">
                                                <h5 class="mb-0" style="display: inline-block;"><%= Address.name %></h5>
                                                <input type="radio" name="selectedAddress" value="<%= Address._id %>" data-address-id="<%= Address._id %>" <%= Address.selected ? 'checked' : '' %>>

                                            </div>
                                        </div>
                                        <div class="card-body">
                                            <address><%= Address.address %><br>
                                                <%= Address.landmark %>,<br> <%= Address.city %>. <br><%= Address.state %>, <%= Address.pincode %></address>
                                            <p><%= Address.country %></p>
                                            <p><%= Address.phone %></p>
                                            <p><%= Address.altphone %></p>
                                            <a href="edit-address?id=<%= Address._id %>" class="btn-small">Edit</a>
                                            <a href="/delete-address?id=<%= Address._id %>" class="btn-small">Delete</a>
                                        </div>
                                    </div>
                                </div>
                            <% })} else { %>
                                <p>No userAddress</p>
                        <% } %>
