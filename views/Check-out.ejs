    document.addEventListener('DOMContentLoaded', function () {
    const totalSubtotalElement = document.querySelector('.product-subtotal span');

    if (totalSubtotalElement) {
        let totalSubtotalText = totalSubtotalElement.innerText.trim();
        let totalSubtotal = parseFloat(totalSubtotalText.replace(/[^\d.]/g, ''));

        if (isNaN(totalSubtotal)) {
            console.error("Invalid totalSubtotal value extracted.");
            return;
        }

        window.originalTotal = totalSubtotal; 

        window.ship = totalSubtotal >= 1000 ? 0 : 40;

        const couponCode = document.getElementById('coupon').value;
        if (couponCode) {
            displayAppliedCouponMessage(couponCode);
        }
    } else {
        console.error("Subtotal element not found.");
    }
});


    async function applyCoupon(event) {

        
        event.preventDefault();
        const couponCode = document.getElementById('coupon').value;
    
        const totalSubtotalElement = document.querySelector('.product-subtotal span');

    if (totalSubtotalElement) {
        let totalSubtotalText = totalSubtotalElement.innerText.trim();
        let totalSubtotal = parseFloat(totalSubtotalText.replace(/[^\d.]/g, ''));

        if (isNaN(totalSubtotal)) {
            console.error("Invalid totalSubtotal value extracted.");
            Swal.fire("Error", "Failed to retrieve subtotal amount.", "error");
            return;
        }

        console.log("Total Subtotal before sending:", totalSubtotal);

        try {
                const response = await fetch('/applyCoupon', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ coupon: couponCode, totalSubtotal }),
                });
                console.log(response,"response");
                
                
                    const data = await response.json();
                    console.log(data,"data");
    

                if (response.status === 200) {
                    Swal.fire('Success', "Coupon applied successfully!", 'success');
                    const discount = data.discount;
                    const discountedTotal = totalSubtotal - discount;
                    updateTotalAmount(totalSubtotal,discountedTotal,discount);
                    displayAppliedCouponMessage(couponCode);
                } else if (response.status === 400) {
                    Swal.fire('Error', `Minimum purchasing amount should be ₹${data.miniamount}`, 'error');
                } 
                else if(response.status===404)
                {
                    Swal.fire('Error',"you have already used this coupon,this coupon has exceeded usagelimit","error")
                }else if(response.status===409){
                    Swal.fire('Error', "couponcode is not valid. Please try again.", 'error');
                }
                else {
        Swal.fire('Error', "Failed to apply coupon. Please try again.", 'error');
    }
                
            } catch (error) {
                console.error('Error applying coupon:', error);
                Swal.fire('Error', "Failed to apply coupon. Please try again.", 'error');
            }
        } else {
            console.error('Total subtotal element not found.');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const couponCode = document.getElementById('coupon').value;
        if (couponCode) {
            displayAppliedCouponMessage(couponCode);
        }
    });

    function displayAppliedCouponMessage(couponCode) {
        const appliedCouponMessage = document.getElementById('appliedCouponMessage');
        if (appliedCouponMessage) {
            appliedCouponMessage.textContent = `Coupon "${couponCode}" applied!`;
            const removeCouponButton = document.getElementById('removeCouponButton');
            if (removeCouponButton) {
                removeCouponButton.style.display = 'inline';
            } else {
                console.error('Remove coupon button not found.');
            }
        } else {
            console.error('Applied coupon message element not found.');
        }
    }

    async function removeCoupon() {
  try {
    const couponCode = document.getElementById('coupon').value;
    const response = await fetch('/removeCoupon', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({coupon:couponCode}),
    });
    const data = await response.json();
    if (response.status === 200) {
      Swal.fire('Success', data.message, 'success');
     
    restoreOriginalSubtotal()
    document.getElementById('coupon').value = '';
      resetCouponUI()
    } else {
      Swal.fire('Error', data.message, 'error');
    }
  } catch (error) {
    console.error('Error removing coupon:', error);
    Swal.fire('Error', "Failed to remove coupon. Please try again.", 'error');
  }
}
function restoreOriginalSubtotal() {
    const totalAmountElement = document.querySelector('.total-amount span');
    if (totalAmountElement) {
        totalAmountElement.innerText = `₹${originalTotal.toFixed(2)}`;
    }
    const totalshipAmount=document.getElementById('total-ship')
    totalshipAmount.innerHTML=` ₹${originalTotal.toFixed(2)}`

}
function resetCouponUI() {
    document.getElementById('appliedCouponMessage').innerHTML = '';
    document.getElementById('removeCouponButton').style.display = 'none';
    document.getElementById('coupon').value = ''; 
    document.getElementById('discountMessage').style.display = 'none';
}
    
    function updateTotalAmount(beforeDiscount, afterDiscount, discount) {
    const totalAmountElement = document.querySelector('.total-amount span');
    const discountMessage = document.getElementById('discountMessage');

    if (totalAmountElement) {
        totalAmountElement.innerHTML = `
            <span style="text-decoration: line-through; color: red;">₹${beforeDiscount.toFixed(2)}</span> 
            → ₹${afterDiscount.toFixed(2)}
        `;
    }

    if (discountMessage) {
        discountMessage.innerHTML = `Discount: ₹${afterDiscount.toFixed(2)}`;
        discountMessage.style.display = 'block';
    }
    const totalshipAmount=document.getElementById('total-ship')
    totalshipAmount.innerHTML=` ₹${discount.toFixed(2)}`
}
</script>
      
         

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
    
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>                      
    <script>    
function placeOrder() {
    Swal.fire({
        title: "Are you sure?",
        text: "Are you sure you want to place the order?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, place order!"
    }).then((result) => {
        if (!result.isConfirmed) return;

        const selectedAddressInput = document.querySelector('input[name="selectedAddress"]:checked');
        const selectedAddressId = selectedAddressInput ? selectedAddressInput.dataset.addressId : null;
        const subtotalText = document.querySelector('.product-subtotal').textContent;
        const subtotal = parseInt(subtotalText.replace(/[^\d.]/g, ''));

        if (!selectedAddressId) {
            return Swal.fire("Error!", "Please select an address.", "error");
        }

        const paymentOptionInput = document.querySelector('input[name="payment_option"]:checked');
        const paymentOption = paymentOptionInput ? paymentOptionInput.value : null;

        if (!paymentOption) {
            return Swal.fire("Error!", "Please select a payment option.", "error");
        }

        const couponCode = document.getElementById('coupon').value;

        $.ajax({
            url: '/place-order',
            method: 'POST',
            data: { addressId: selectedAddressId, paymentoption: paymentOption, subtotal, coupon: couponCode },
            success: (response) => {
                if (response.success && response.method === "Online") {
                    handleRazorpayPayment(response);
                } else if (response.status === 400 && response.jibo === "ben" && response.method === "Wallet") {
                    Swal.fire("Error!", "Failed to process wallet payment.", "error");
                } else if (response.jibo === "glen" && response.method === "Wallet") {
                    showOrderSuccess();
                } else if (response.success && response.method === "COD") {
                    showOrderSuccess();
                } else {
                    Swal.fire("Error!", "Failed to place the order.", "error");
                }
            },
            error: (error) => {
                console.error("AJAX error:", error);
                Swal.fire("Error!", "Failed to place the order.", "error");
            }
        });
    });
}

function handleRazorpayPayment(response) {
    var orderId = response.razorpayorder.receipt;
    var options = {
        "key": response.razorId,
        "amount": response.razorpayorder.amount * 100,
        "currency": "INR",
        "name": "Tech Tique",
        "description": "Test Transaction",
        "image": "https://example.com/your_logo",
        "order_id": response.razorpayorder.id,
        "handler": function (data) {
            console.log("payment success handler",data);
            
            verifyPayment(response.razorpayorder.receipt, data);
        },
        "prefill": {
            "name": "customername",
            "email": "customer@example.com",
            "contact": "9000090000"
        },
        "notes": {
            "address": "Razorpay Corporate Office"
        },
        "theme": {
            "color": "#3399cc"
        },
        'modal':{
        'ondismiss': function () {
                if (window.paymentFailed) {
                    window.location.href = '/profile#orders';
                }
            }
        }
    };

    var rzp1 = new Razorpay(options);
    rzp1.on('payment.failed', function (response) {
        console.error("Payment failed:", response.error);
        Swal.fire("Payment Failed!", response.error.description || "Transaction was not successful.", "error");
        window.paymentFailed=true
        $.ajax({
            url: '/verify-payment',
            method: 'POST',
            data: {
                orderId: orderId,
                data: response
            },
            error: function (error) {
                console.error("Error verifying payment:", error);
                Swal.fire("Error!", "Failed to verify payment.", "error");
            }
        });
    });
    rzp1.open();
}

function verifyPayment(orderId, data) {
    console.log("Calling /verify-payment with:", orderId, data);
    $.ajax({
        url: '/verify-payment',
        method: 'POST',
        data: { orderId, data },
        success: function (response) {
            showOrderSuccess();
        },
        error: function (error) {
            console.error("Payment verification error:", error);
            Swal.fire("Error!", "Failed to verify payment.", "error");
        }
    });
}

function showOrderSuccess() {
    Swal.fire("Order Placed!", "Your order has been placed successfully.", "success");
    setTimeout(() => {
        window.location.href = '/profile#orders';
    }, 2000);
}

</script>


