                    <input type="text" id="coupon" name="coupon" style="width:200px;">
                    <button type="submit" onclick="applyCoupon(event)">Apply</button>
                </form>
                <button id="showCouponsBtn" type="button" class="btn-dark" onclick="showCouponModal()">Apply Promo</button>


<div class="modal" id="couponModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Select a Coupon</h5>
        <button type="button" class="close btn-dark" data-dismiss="modal" aria-label="Close" onclick="closeCouponModal()">
            <span aria-hidden="true">&times;</span>
        </button>
              </div>
      <div class="modal-body">
    
        <% if (Coupons && Coupons.length > 0) { %>
            <% Coupons.forEach(coupon => { %>
                <p><%= coupon.Couponcode %> - <%= coupon.Description %> - <%= coupon.Coupontype %> - <%= coupon.Amount %> - <%= coupon.Usagelimit %> - <%= coupon.Expirydate %></p>
                <button class="btn btn-primary"  onclick="selectCoupon('<%= coupon.Couponcode %>')">Select</button>
            <% }); %>
        <% } else { %>
            <p>No coupons available.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

